    <!-- DeepSeek: tarifa por franja horaria. Se guarda la de hora punta
         (01:00-04:00 y 06:00-10:00 UTC, lunes a viernes), así el costo
         estimado es una cota superior. No publica RPM/TPM: limita por
         conexiones simultáneas. -->
    <record id="spec_deepseek_flash" model="ai.model.spec">
        <field name="provider">deepseek</field>
        <field name="model_id">deepseek-flash</field>
        <field name="name">DeepSeek Flash</field>
        <field name="context_window">1000000</field>
        <field name="max_output_tokens">384000</field>
        <field name="input_cost_per_mtok">0.30</field>
        <field name="output_cost_per_mtok">1.20</field>
        <field name="pricing_known" eval="True"/>
        <field name="supports_tools" eval="True"/>
        <field name="supports_streaming" eval="True"/>
        <field name="source">official</field>
        <field name="source_url">https://api-docs.deepseek.com/quick_start/pricing</field>
        <field name="verified_on">2026-09-12</field>
        <field name="notes">Precio de hora punta (entrada sin caché). Fuera de punta: 0,15 / 0,60 USD. Entrada con caché: 0,006 USD (punta). Límite: 2500 conexiones simultáneas; sin tier gratuito.</field>
    </record>
