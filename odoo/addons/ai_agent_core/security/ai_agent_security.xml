<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ai_agent_core" model="ir.module.category">
        <field name="name">Agentes de IA</field>
        <field name="sequence">25</field>
    </record>

    <record id="res_groups_privilege_ai_agent_core" model="res.groups.privilege">
        <field name="name">Agentes de IA</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_ai_agent_core"/>
    </record>

    <record id="group_ai_agent_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="privilege_id" ref="res_groups_privilege_ai_agent_core"/>
        <field name="comment">
            Puede conversar con los agentes, ejecutar herramientas de riesgo 0/1,
            y ver el estado de sus propias solicitudes de aprobación.
        </field>
    </record>

    <record id="group_ai_agent_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="privilege_id" ref="res_groups_privilege_ai_agent_core"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_agent_user'))]"/>
        <field name="comment">
            Puede aprobar/rechazar operaciones de riesgo 2/3, configurar agentes,
            herramientas y proveedores de IA, y ver el log de auditoría completo.
        </field>
    </record>

    <record id="ai_approval_rule_own_pending" model="ir.rule">
        <field name="name">Aprobación: usuarios ven las propias, managers ven todas</field>
        <field name="model_id" ref="model_ai_approval_request"/>
        <field name="domain_force">
            ['|', ('requesting_user_id', '=', user.id), ('company_id', 'in', company_ids)]
        </field>
        <field name="groups" eval="[(4, ref('group_ai_agent_user'))]"/>
    </record>

    <record id="ai_approval_rule_manager_all" model="ir.rule">
        <field name="name">Aprobación: managers ven todo de su empresa</field>
        <field name="model_id" ref="model_ai_approval_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_ai_agent_manager'))]"/>
    </record>

    <!-- Sin 'groups': reglas globales, se combinan con AND sobre cualquier
         otra regla de grupo — aíslan por empresa a todo usuario, igual que
         el patrón multiempresa estándar del resto de Odoo. Ver
         ARIA_Especificacion_Tecnica.md §14.10 ("Un usuario de otra empresa
         no puede ver ni aprobar operaciones de esta empresa"): antes de
         esto, ai.audit.log y ai.conversation no tenían ir.rule propia pese
         a tener company_id. -->
    <record id="ai_audit_log_rule_company" model="ir.rule">
        <field name="name">Auditoría: solo de la propia empresa</field>
        <field name="model_id" ref="model_ai_audit_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="ai_conversation_rule_company" model="ir.rule">
        <field name="name">Conversaciones: solo de la propia empresa</field>
        <field name="model_id" ref="model_ai_conversation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
