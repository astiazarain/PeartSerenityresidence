<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_approval_request_list" model="ir.ui.view">
        <field name="name">ai.approval.request.list</field>
        <field name="model">ai.approval.request</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'pending'" decoration-danger="state == 'error'"
                  decoration-success="state == 'executed'" decoration-muted="state in ('rejected','cancelled','expired')">
                <field name="create_date" string="Solicitada"/>
                <field name="agent_id"/>
                <field name="tool_id"/>
                <field name="risk_level"/>
                <field name="requesting_user_id"/>
                <field name="approver_user_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_ai_approval_request_form" model="ir.ui.view">
        <field name="name">ai.approval.request.form</field>
        <field name="model">ai.approval.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Aprobar"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_reject" type="object" string="Rechazar"
                            invisible="state != 'pending'"/>
                    <button name="action_cancel" type="object" string="Cancelar"
                            invisible="state not in ('draft', 'pending')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,executed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="agent_id"/>
                            <field name="tool_id"/>
                            <field name="risk_level"/>
                            <field name="conversation_id"/>
                        </group>
                        <group>
                            <field name="requesting_user_id"/>
                            <field name="approver_user_id"/>
                            <field name="requested_at"/>
                            <field name="approved_at"/>
                            <field name="executed_at"/>
                        </group>
                    </group>
                    <group string="Vista previa">
                        <field name="preview_text" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Parámetros">
                            <field name="payload_json" widget="text"/>
                        </page>
                        <page string="Resultado" invisible="state not in ('executed','error')">
                            <field name="execution_result_json" widget="text"/>
                            <field name="error_message"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_approval_request_search" model="ir.ui.view">
        <field name="name">ai.approval.request.search</field>
        <field name="model">ai.approval.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="agent_id"/>
                <field name="tool_id"/>
                <field name="requesting_user_id"/>
                <filter name="pending" string="Pendientes" domain="[('state', '=', 'pending')]"/>
                <filter name="mine" string="Mías" domain="[('requesting_user_id', '=', uid)]"/>
                <group>
                    <filter name="group_agent" string="Agente" context="{'group_by': 'agent_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_approval_request" model="ir.actions.act_window">
        <field name="name">Vault — Aprobaciones</field>
        <field name="res_model">ai.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
