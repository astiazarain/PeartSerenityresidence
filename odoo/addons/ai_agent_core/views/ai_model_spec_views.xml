<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_model_spec_list" model="ir.ui.view">
        <field name="name">ai.model.spec.list</field>
        <field name="model">ai.model.spec</field>
        <field name="arch" type="xml">
            <list decoration-muted="not pricing_known">
                <field name="provider"/>
                <field name="model_id"/>
                <field name="context_window"/>
                <field name="input_cost_per_mtok"/>
                <field name="output_cost_per_mtok"/>
                <field name="pricing_known" optional="hide"/>
                <field name="free_rpm" optional="show"/>
                <field name="free_rpd" optional="show"/>
                <field name="free_tpm" optional="show"/>
                <field name="free_tpd" optional="hide"/>
                <field name="supports_tools"/>
                <field name="supports_streaming"/>
                <field name="source"/>
                <field name="verified_on"/>
            </list>
        </field>
    </record>

    <record id="view_ai_model_spec_form" model="ir.ui.view">
        <field name="name">ai.model.spec.form</field>
        <field name="model">ai.model.spec</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="provider"/>
                            <field name="model_id"/>
                            <field name="name"/>
                            <field name="context_window"/>
                            <field name="max_output_tokens"/>
                            <field name="supports_tools"/>
                            <field name="supports_streaming"/>
                            <field name="active"/>
                        </group>
                        <group string="Precio">
                            <field name="pricing_known"/>
                            <field name="input_cost_per_mtok"/>
                            <field name="output_cost_per_mtok"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tier gratuito">
                            <field name="free_rpm"/>
                            <field name="free_rpd"/>
                            <field name="free_tpm"/>
                            <field name="free_tpd"/>
                        </group>
                        <group string="Fuente">
                            <field name="source"/>
                            <field name="source_url" widget="url"/>
                            <field name="verified_on"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Salvedades del dato (tarifas por franja horaria, límites no publicados...)"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_model_spec_search" model="ir.ui.view">
        <field name="name">ai.model.spec.search</field>
        <field name="model">ai.model.spec</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_id"/>
                <field name="provider"/>
                <filter name="with_tools" string="Con tool calling" domain="[('supports_tools', '=', True)]"/>
                <filter name="no_price" string="Sin precio conocido" domain="[('pricing_known', '=', False)]"/>
                <separator/>
                <filter name="inactive" string="Archivadas" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_provider" string="Proveedor" context="{'group_by': 'provider'}"/>
                    <filter name="group_source" string="Fuente" context="{'group_by': 'source'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_model_spec" model="ir.actions.act_window">
        <field name="name">Especificaciones de modelos</field>
        <field name="res_model">ai.model.spec</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_provider': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Sin especificaciones de modelos</p>
            <p>
                Contexto, precio y límites de cada modelo. Las de OpenRouter,
                Abacus y Mistral se completan al actualizar el catálogo del
                proveedor; con ellas se calcula el costo de cada llamada en la
                auditoría.
            </p>
        </field>
    </record>
</odoo>
