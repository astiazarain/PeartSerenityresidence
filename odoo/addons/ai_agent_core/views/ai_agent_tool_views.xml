<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_agent_tool_list" model="ir.ui.view">
        <field name="name">ai.agent.tool.list</field>
        <field name="model">ai.agent.tool</field>
        <field name="arch" type="xml">
            <list>
                <field name="agent_id"/>
                <field name="name"/>
                <field name="label"/>
                <field name="risk_level"/>
                <field name="requires_approval"/>
                <field name="target_model"/>
                <field name="target_method"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ai_agent_tool_form" model="ir.ui.view">
        <field name="name">ai.agent.tool.form</field>
        <field name="model">ai.agent.tool</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="agent_id"/>
                            <field name="name"/>
                            <field name="label"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="risk_level"/>
                            <field name="requires_approval" readonly="1"/>
                            <field name="idempotent"/>
                            <field name="required_group_id"/>
                        </group>
                    </group>
                    <group string="Implementación">
                        <field name="target_model"/>
                        <field name="target_method"/>
                    </group>
                    <field name="description" placeholder="Qué hace esta herramienta..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_agent_tool_search" model="ir.ui.view">
        <field name="name">ai.agent.tool.search</field>
        <field name="model">ai.agent.tool</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="agent_id"/>
                <filter name="requires_approval" string="Requiere aprobación"
                        domain="[('requires_approval', '=', True)]"/>
                <group>
                    <filter name="group_agent" string="Agente" context="{'group_by': 'agent_id'}"/>
                    <filter name="group_risk" string="Nivel de riesgo" context="{'group_by': 'risk_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_agent_tool" model="ir.actions.act_window">
        <field name="name">Herramientas</field>
        <field name="res_model">ai.agent.tool</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
