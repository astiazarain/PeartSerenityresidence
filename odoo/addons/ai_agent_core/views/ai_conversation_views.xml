<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_conversation_list" model="ir.ui.view">
        <field name="name">ai.conversation.list</field>
        <field name="model">ai.conversation</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'escalated'" decoration-muted="state == 'closed'">
                <field name="write_date" string="Última actividad"/>
                <field name="agent_id"/>
                <field name="user_id"/>
                <field name="external_contact"/>
                <field name="message_count"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_ai_conversation_form" model="ir.ui.view">
        <field name="name">ai.conversation.form</field>
        <field name="model">ai.conversation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_escalate" type="object" string="Escalar a humano"
                            invisible="state != 'active'"/>
                    <button name="action_close" type="object" string="Cerrar"
                            invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="agent_id"/>
                        <field name="user_id"/>
                        <field name="external_contact"/>
                        <field name="company_id"/>
                    </group>
                    <field name="message_ids">
                        <list editable="bottom" create="false">
                            <field name="role"/>
                            <field name="content"/>
                            <field name="tool_name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_conversation" model="ir.actions.act_window">
        <field name="name">Conversaciones</field>
        <field name="res_model">ai.conversation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
