<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_agent_log_list" model="ir.ui.view">
        <field name="name">ai.agent.log.list</field>
        <field name="model">ai.agent.log</field>
        <field name="arch" type="xml">
            <list string="Conversaciones del Agente IA">
                <field name="create_date"/>
                <field name="session_id"/>
                <field name="user_message"/>
                <field name="route"/>
            </list>
        </field>
    </record>

    <record id="view_ai_agent_log_form" model="ir.ui.view">
        <field name="name">ai.agent.log.form</field>
        <field name="model">ai.agent.log</field>
        <field name="arch" type="xml">
            <form string="Conversación">
                <sheet>
                    <group>
                        <field name="session_id"/>
                        <field name="route"/>
                    </group>
                    <group>
                        <field name="user_message"/>
                        <field name="reply_text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_agent_log" model="ir.actions.act_window">
        <field name="name">Conversaciones del Agente IA</field>
        <field name="res_model">ai.agent.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ai_agent_log_root"
              name="AI Customer Agent"
              sequence="95"/>
    <menuitem id="menu_ai_agent_log"
              name="Conversaciones"
              parent="menu_ai_agent_log_root"
              action="action_ai_agent_log"
              sequence="10"/>
</odoo>
