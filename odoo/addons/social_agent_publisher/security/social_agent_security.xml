<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_social_agent" model="ir.module.category">
        <field name="name">Social Agent Publisher</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_social_agent" model="res.groups.privilege">
        <field name="name">Social Agent Publisher</field>
        <field name="category_id" ref="module_category_social_agent"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_social_agent_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="privilege_id" ref="res_groups_privilege_social_agent"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_social_agent_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="privilege_id" ref="res_groups_privilege_social_agent"/>
        <field name="implied_ids" eval="[(4, ref('group_social_agent_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
