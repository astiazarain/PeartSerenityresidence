<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_provider_config_list" model="ir.ui.view">
        <field name="name">ai.provider.config.list</field>
        <field name="model">ai.provider.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="provider"/>
                <field name="model_name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ai_provider_config_form" model="ir.ui.view">
        <field name="name">ai.provider.config.form</field>
        <field name="model">ai.provider.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej: Claude producción"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="provider" widget="radio"/>
                            <field name="model_name"/>
                            <field name="api_key" password="True"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Instrucción de sistema">
                        <field name="system_prompt" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ai_provider_config" model="ir.actions.act_window">
        <field name="name">Proveedores de IA</field>
        <field name="res_model">ai.provider.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configura tu primer proveedor de IA (Claude o Gemini).
            </p>
        </field>
    </record>
</odoo>
