<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_clinical" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.peart.clinical</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Peart Clinical Record" string="Peart Clinical Record" name="peart_clinical_record">
                    <block title="Family assistant (ARIA)" id="peart_clinical_aria">
                        <setting string="AI provider for families"
                                 help="Resident data is sent to this provider when a family member asks ARIA a question. Choose one approved for health data. There is no fallback provider.">
                            <field name="peart_family_ai_provider_id" options="{'no_create': True, 'no_open': True}"/>
                        </setting>
                        <setting string="AI provider for staff (ARIA Clínica)"
                                 help="Resident data (pseudonymised) is sent to this provider when staff ask ARIA Clínica a question. Choose one approved for health data. There is no fallback provider.">
                            <field name="peart_staff_ai_provider_id" options="{'no_create': True, 'no_open': True}"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
