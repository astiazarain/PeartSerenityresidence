<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="peart_shift_handover_view_list" model="ir.ui.view">
        <field name="name">peart.shift.handover.list</field>
        <field name="model">peart.shift.handover</field>
        <field name="arch" type="xml">
            <list decoration-danger="open_incidents_count or overdue_doses_count">
                <field name="name"/>
                <field name="generated_at"/>
                <field name="overdue_doses_count" string="Overdue doses"/>
                <field name="unclosed_logs_count" string="Logs not closed"/>
                <field name="open_incidents_count" string="Open incidents"/>
                <field name="vital_alerts_count" string="Vital alerts"/>
                <field name="family_questions_count" string="Family questions"/>
            </list>
        </field>
    </record>

    <record id="peart_shift_handover_view_form" model="ir.ui.view">
        <field name="name">peart.shift.handover.form</field>
        <field name="model">peart.shift.handover</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_now" type="object" string="Generate current shift now"
                            groups="peart_clinical_record.group_clinical_doctor"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <field name="generated_at" readonly="1"/>
                    </group>
                    <group string="Overdue / not given doses">
                        <field name="overdue_doses_count" readonly="1"/>
                        <field name="overdue_doses_detail" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Shift logs not closed">
                        <field name="unclosed_logs_count" readonly="1"/>
                        <field name="unclosed_logs_detail" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Open incidents">
                        <field name="open_incidents_count" readonly="1"/>
                        <field name="open_incidents_detail" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Vital sign alerts (24 h)">
                        <field name="vital_alerts_count" readonly="1"/>
                        <field name="vital_alerts_detail" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Family questions pending">
                        <field name="family_questions_count" readonly="1"/>
                        <field name="family_questions_detail" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="peart_shift_handover_action" model="ir.actions.act_window">
        <field name="name">Shift Handover</field>
        <field name="res_model">peart.shift.handover</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
