<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_peart_resident" model="ir.sequence">
        <field name="name">Resident Code</field>
        <field name="code">peart.resident</field>
        <field name="prefix">RES-</field>
        <field name="padding">5</field>
    </record>
    <record id="seq_peart_incident" model="ir.sequence">
        <field name="name">Incident Reference</field>
        <field name="code">peart.incident</field>
        <field name="prefix">INC-</field>
        <field name="padding">5</field>
    </record>

    <record id="cron_generate_medication_round" model="ir.cron">
        <field name="name">Peart: schedule medication doses</field>
        <field name="model_id" ref="model_peart_resident_medication"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_administrations()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
