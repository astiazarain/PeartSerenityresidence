<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Care Type -->
    <record id="care_type_day_care" model="peart.care.type">
        <field name="name">Adult Day Care</field>
        <field name="code">day_care</field>
        <field name="sequence">10</field>
    </record>
    <record id="care_type_respite" model="peart.care.type">
        <field name="name">Respite Care</field>
        <field name="code">respite</field>
        <field name="sequence">20</field>
    </record>
    <record id="care_type_long_term" model="peart.care.type">
        <field name="name">Long-Term Residential</field>
        <field name="code">long_term</field>
        <field name="sequence">30</field>
    </record>
    <record id="care_type_private_suite" model="peart.care.type">
        <field name="name">Private Suite</field>
        <field name="code">private_suite</field>
        <field name="sequence">40</field>
    </record>
    <record id="care_type_recovery" model="peart.care.type">
        <field name="name">Post-Surgical Recovery</field>
        <field name="code">recovery</field>
        <field name="sequence">50</field>
    </record>
    <record id="care_type_specialized" model="peart.care.type">
        <field name="name">Specialized Care</field>
        <field name="code">specialized</field>
        <field name="sequence">60</field>
    </record>

    <!-- Urgency Level -->
    <record id="urgency_low" model="peart.urgency.level">
        <field name="name">Low — Exploring options</field>
        <field name="code">low</field>
        <field name="sequence">10</field>
    </record>
    <record id="urgency_medium" model="peart.urgency.level">
        <field name="name">Medium — Within 3 months</field>
        <field name="code">medium</field>
        <field name="sequence">20</field>
    </record>
    <record id="urgency_high" model="peart.urgency.level">
        <field name="name">High — Immediate need</field>
        <field name="code">high</field>
        <field name="sequence">30</field>
    </record>

</odoo>
