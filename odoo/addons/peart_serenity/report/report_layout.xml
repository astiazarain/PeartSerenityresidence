<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Custom PDF document layout: gold-on-black header/footer matching the
             Peart Serenity Brand Identity Manual. Wired onto the company via
             external_report_layout_id (data/company_data.xml), so it drives every
             stock business document, quotations and invoices in particular. -->
        <template id="external_layout_peart" name="Peart Serenity Layout">

            <div t-attf-class="header o_company_#{company.id}_layout o_peart_layout">
                <div class="o_peart_header_bar">
                    <div class="row align-items-center gx-2">
                        <div class="col-2">
                            <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" class="o_peart_logo" alt="Logo"/>
                        </div>
                        <div class="col-6">
                            <div class="o_peart_company_name" t-esc="company.name">Peart Serenity Residence</div>
                            <div class="o_peart_tagline">Where Care Feels Like Home</div>
                        </div>
                        <div class="col-4 text-end o_peart_header_contact" name="company_address">
                            <div t-if="company.is_company_details_empty">
                                <span t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "phone", "email"], "no_marker": true}'/>
                            </div>
                            <div t-else="">
                                <span t-field="company.company_details"/>
                            </div>
                            <div t-if="forced_vat">
                                <t t-esc="company.country_id.vat_label or 'Tax ID'"/>: <span t-esc="forced_vat"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="o_peart_header_rule"/>
            </div>

            <t t-set="layout_background_url"
                t-value="'data:image/png;base64,%s' % company.layout_background_image.decode('utf-8') if company.layout_background_image and company.layout_background == 'Custom' else ''"/>
            <div t-attf-class="article o_peart_layout o_company_#{company.id}_layout"
                 t-attf-style="{{ 'background-image: url(%s);' % layout_background_url if layout_background_url else '' }}"
                 t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                <div class="pt-5">
                    <!-- Keeps the recipient address from being cropped by the header -->
                    <t t-call="web.address_layout"/>
                </div>
                <h2 class="o_peart_doc_title" t-out="layout_document_title"/>
                <t t-out="0"/>
            </div>

            <div t-attf-class="footer o_company_#{company.id}_layout o_peart_layout o_peart_footer">
                <div class="o_peart_footer_rule"/>
                <div class="row">
                    <div class="col-4 text-start o_peart_footer_text">
                        <span t-field="company.report_footer"/>
                    </div>
                    <div class="col-4 text-center o_peart_footer_tagline">Where Care Feels Like Home</div>
                    <div class="col-4 text-end o_peart_footer_page">
                        <t t-if="report_type == 'pdf'">Page <span class="page"/> / <span class="topage"/></t>
                    </div>
                </div>
                <div t-if="report_type == 'pdf' and display_name_in_footer" class="text-center o_peart_footer_docname">
                    <span t-out="o.name">(document name)</span>
                </div>
            </div>
        </template>

    </data>
</odoo>
