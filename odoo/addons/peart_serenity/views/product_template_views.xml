<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Adds the native-style "Published/Unpublished" smart button to the
         product form, backed by website.published.mixin (is_published).
         /api/services and similar public routes should only ever expose
         products where type='service' and is_published=True. -->
    <record id="product_template_view_form_peart_published" model="ir.ui.view">
        <field name="name">product.template.form.peart.published</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <span id="button_website" position="replace">
                <button name="website_publish_button" type="object" class="oe_stat_button" icon="fa-globe">
                    <field name="is_published" widget="website_publish_button"/>
                </button>
            </span>
            <field name="description_sale" position="after">
                <field name="website_price_period"/>
                <field name="website_features"
                       placeholder="One bullet point per line, shown as a checklist on the public Services page."/>
            </field>
        </field>
    </record>

</odoo>
