<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="peart_gallery_photo_view_kanban" model="ir.ui.view">
        <field name="name">peart.gallery.photo.kanban</field>
        <field name="model">peart.gallery.photo</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category">
                <field name="title"/>
                <field name="category"/>
                <field name="image_512"/>
                <field name="published"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <img t-att-src="'/web/image/peart.gallery.photo/' + record.id.raw_value + '/image_512'"
                                 t-att-alt="record.title.value"
                                 class="o_kanban_image w-100" style="height:140px;object-fit:cover;"/>
                            <strong><field name="title"/></strong>
                            <div t-if="!record.published.raw_value" class="text-muted">Unpublished</div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="peart_gallery_photo_view_form" model="ir.ui.view">
        <field name="name">peart.gallery.photo.form</field>
        <field name="model">peart.gallery.photo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title"><h1><field name="title"/></h1></div>
                    <group>
                        <field name="category"/>
                        <field name="sequence"/>
                        <field name="published"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="peart_gallery_photo_view_list" model="ir.ui.view">
        <field name="name">peart.gallery.photo.list</field>
        <field name="model">peart.gallery.photo</field>
        <field name="arch" type="xml">
            <list>
                <field name="title"/>
                <field name="category"/>
                <field name="sequence" widget="handle"/>
                <field name="published"/>
            </list>
        </field>
    </record>

    <record id="peart_gallery_photo_action" model="ir.actions.act_window">
        <field name="name">Gallery</field>
        <field name="res_model">peart.gallery.photo</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Add the first photo to the gallery.</p>
            <p>Only published photos are shown on the website's Gallery page.</p>
        </field>
    </record>

    <menuitem id="peart_gallery_photo_menu" name="Gallery" parent="peart_admission_menu_root"
              action="peart_gallery_photo_action" sequence="6"/>

</odoo>
