<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Care Type -->
    <record id="peart_care_type_view_list" model="ir.ui.view">
        <field name="name">peart.care.type.list</field>
        <field name="model">peart.care.type</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="peart_care_type_view_form" model="ir.ui.view">
        <field name="name">peart.care.type.form</field>
        <field name="model">peart.care.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="peart_care_type_action" model="ir.actions.act_window">
        <field name="name">Care Types</field>
        <field name="res_model">peart.care.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">No care types yet.</p>
            <p>Only active values are offered on the public website (Waitlist and Quote Request forms).</p>
        </field>
    </record>

    <!-- Urgency Level -->
    <record id="peart_urgency_level_view_list" model="ir.ui.view">
        <field name="name">peart.urgency.level.list</field>
        <field name="model">peart.urgency.level</field>
        <field name="arch" type="xml">
            <list decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="peart_urgency_level_view_form" model="ir.ui.view">
        <field name="name">peart.urgency.level.form</field>
        <field name="model">peart.urgency.level</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="peart_urgency_level_action" model="ir.actions.act_window">
        <field name="name">Urgency Levels</field>
        <field name="res_model">peart.urgency.level</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">No urgency levels yet.</p>
            <p>Only active values are offered on the public website (Waitlist and Quote Request forms).</p>
        </field>
    </record>

    <menuitem id="peart_nomenclator_menu_root" name="Nomenclators" parent="peart_admission_menu_root" sequence="6"/>
    <menuitem id="peart_care_type_menu" name="Care Types" parent="peart_nomenclator_menu_root"
              action="peart_care_type_action" sequence="1"/>
    <menuitem id="peart_urgency_level_menu" name="Urgency Levels" parent="peart_nomenclator_menu_root"
              action="peart_urgency_level_action" sequence="2"/>

</odoo>
