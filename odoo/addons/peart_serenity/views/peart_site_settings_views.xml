<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="peart_site_settings_view_form" model="ir.ui.view">
        <field name="name">peart.site.settings.form</field>
        <field name="model">peart.site.settings</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group string="WhatsApp">
                        <field name="whatsapp_number"/>
                        <field name="whatsapp_message"/>
                    </group>
                    <group string="Social Media">
                        <field name="facebook_url" placeholder="https://facebook.com/..."/>
                        <field name="instagram_url" placeholder="https://instagram.com/..."/>
                        <field name="tiktok_url" placeholder="https://tiktok.com/@..."/>
                        <field name="linkedin_url" placeholder="https://linkedin.com/..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Opens the seeded singleton record directly - no list, no create/delete. -->
    <record id="peart_site_settings_action" model="ir.actions.act_window">
        <field name="name">Website Settings</field>
        <field name="res_model">peart.site.settings</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="site_settings_default"/>
    </record>

    <menuitem id="peart_site_settings_menu" name="Website Settings" parent="peart_admission_menu_root"
              action="peart_site_settings_action" sequence="5"/>

</odoo>
